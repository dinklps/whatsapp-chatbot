# Copy to .env and fill in. Never commit .env.

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret (Meta app > Settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same value when registering the webhook in Meta.
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v24.0

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Storage ---
# SQLite to start. For PostgreSQL: postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./data/bot.db

# --- Behaviour ---
# true = print outgoing WhatsApp messages instead of sending them
DRY_RUN=true
# Meta-approved utility template used to alert staff (see README)
ALERT_TEMPLATE_NAME=intake_alert
ALERT_TEMPLATE_LANG=en
# Hours of silence after which a caller's next message starts a new enquiry
SESSION_TIMEOUT_HOURS=24
